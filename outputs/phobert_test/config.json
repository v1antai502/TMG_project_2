{
  "data_dir": "data/processed",
  "out_dir": "outputs/phobert_test",
  "model_name": "vinai/phobert-base-v2",
  "max_length": 128,
  "use_lead": true,
  "batch_size": 4,
  "epochs": 1,
  "lr": 2e-05,
  "weight_decay": 0.01,
  "warmup_ratio": 0.1,
  "dropout": 0.1,
  "weighted_loss": true,
  "patience": 3,
  "monitor": "loss",
  "rdrop_alpha": 0.0,
  "layer_decay": 0.9,
  "label_smoothing": 0.0,
  "focal_gamma": 0.0,
  "gce_q": 0.0,
  "supcon_weight": 0.0,
  "supcon_temperature": 0.3,
  "num_workers": 0,
  "segment": true,
  "lead_dropout": 0.5,
  "seed": 42,
  "limit": 100
}